# Banco
DATABASE_URL=jdbc:postgresql://localhost:5432/flowcrm
DATABASE_USERNAME=flowcrm
DATABASE_PASSWORD=flowcrm

# API
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# JWT (Fase 02 — não commitar valores reais)
JWT_SECRET=change-me-in-local-env-use-at-least-256-bits
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Segurança e retenção de auditoria
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUDIT_RETENTION_DAYS=90
