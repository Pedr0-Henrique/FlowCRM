# Copie para .env.production e gere valores fortes e exclusivos antes do deploy.
SITE_ADDRESS=crm.example.com
PUBLIC_ORIGIN=https://crm.example.com

POSTGRES_DB=flowcrm
POSTGRES_USER=flowcrm
POSTGRES_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Gere, por exemplo, com: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
AUDIT_RETENTION_DAYS=90

# Necessários apenas ao iniciar o perfil opcional de monitoramento.
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_GRAFANA_PASSWORD
SMTP_HOST=smtp.example.com:587
SMTP_FROM=flowcrm@example.com
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
ALERT_EMAIL=ops@example.com
